# Local dependencies
node_modules/
mobile/node_modules/

# Local runtime logs
.logs/

# Codex conversation attachments
.codex-remote-attachments/

# Local environment files
.env
.env.*
!.env.example
mobile/.env
mobile/.env.*
!mobile/.env.example

# Generated local databases
*.sqlite
*.sqlite3
*.db

# Dev console local state (mirrors what local-dev-console/.gitignore already excluded)
backend/data/

# Expo / build outputs
.expo/
dist/
build/

# Local system-analysis documents and blueprint images
/system-analysis/

# PostgreSQL dev backups (contain user emails) -- take with pg_dump -Fc before any migration
database/backups/*.dump

# Firebase Android config (FCM push). Local file, not committed -- download from Firebase console.
mobile/google-services.json

# Locally built APKs (named by build date, see scripts/build-android-apk.js)
mobile/apk/
