# Backend
PORT=3000
AUTH_SESSION_SECRET=replace_with_backend_session_secret_at_least_16_chars

# Development auth mode.
# Keep false by default. When true outside production, backend exposes dev-only
# identity switch APIs for local customer/merchant testing.
AUTH_DEV_MODE=false

# Firebase Admin verification for POST /api/auth/firebase-session.
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a local service account JSON file.
# Do not commit that JSON file or paste real service account JSON into git.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=C:\local\secrets\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_with_firebase_project_id"}

# Public Firebase web config for the /admin/login email+password sign-in form -- these are NOT
# secrets (same values already shipped inside the mobile app bundle as EXPO_PUBLIC_FIREBASE_*),
# safe to embed in server-rendered HTML. Firebase Console -> Project settings -> General ->
# Your apps -> Web app. Must belong to the SAME Firebase project as FIREBASE_PROJECT_ID above.
FIREBASE_WEB_API_KEY=replace_with_firebase_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
FIREBASE_WEB_APP_ID=replace_with_firebase_app_id

# PostgreSQL is the permanent Backend runtime. Local PostgreSQL normally does not use TLS;
# Azure PostgreSQL must set DATABASE_SSL=true and keep certificate verification enabled.
DATABASE_URL=postgres://drink_group_buy:replace_with_local_postgres_password@localhost:5432/drink_group_buy
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Keep every Backend repository on the same PostgreSQL runtime. SQLite is isolated to
# compatibility tests whose scripts explicitly override these values.
STORE_MENU_READ_RUNTIME=postgres
STORE_DIRECTORY_READ_RUNTIME=postgres
GROUP_BUY_ACTIVITY_READ_RUNTIME=postgres
GROUP_BUY_ACTIVITY_WRITE_RUNTIME=postgres
MERCHANT_MENU_RUNTIME=postgres
CUSTOMER_ORDER_WRITE_RUNTIME=postgres
CUSTOMER_ORDER_READ_RUNTIME=postgres
PAYMENT_AUTHORIZATION_REQUEST_RUNTIME=postgres
PAYMENT_AUTHORIZATION_CONFIRM_RUNTIME=postgres
PAYMENT_AUTHORIZATION_CANCEL_RUNTIME=postgres
CUSTOMER_ORDER_CANCEL_RUNTIME=postgres
AUTH_PROFILE_READ_RUNTIME=postgres
PAYMENT_CAPTURE_RUNTIME=postgres
GROUP_BUY_SETTLEMENT_RUNTIME=postgres
ORDER_REVISION_RUNTIME=postgres
PAYMENT_REFUND_RUNTIME=postgres
PICKUP_CREDENTIAL_RUNTIME=postgres
PAYMENT_RELIABILITY_JOB_RUNTIME=postgres
MERCHANT_ACTIVITY_CANCEL_RUNTIME=postgres
MANUAL_LINE_PAY_REPAYMENT_RUNTIME=postgres

# LINE Pay sandbox settings
# Copy this file to backend/.env and replace placeholders with your sandbox channel values.
# Do not put LINE_PAY_CHANNEL_SECRET in mobile/.env or any EXPO_PUBLIC_* variable.
LINE_PAY_ENV=sandbox
LINE_PAY_API_BASE_URL=https://sandbox-api-pay.line.me
LINE_PAY_CHANNEL_ID=replace_with_line_pay_channel_id
LINE_PAY_CHANNEL_SECRET=replace_with_line_pay_channel_secret
LINE_PAY_CURRENCY=TWD
# Taiwan LINE Pay channels use automatic capture by default.
# Set this to true only after LINE Pay enables capture-separated payment for the channel.
LINE_PAY_CAPTURE_SEPARATED=false
LINE_PAY_AUTHORIZATION_SETTLEMENT_BUFFER_MINUTES=30

# For Expo Web on the same computer, localhost works.
# For Android phone testing, use a public tunnel URL or your reachable backend URL.
LINE_PAY_CONFIRM_URL=http://localhost:3000/api/payments/line-pay/confirm
LINE_PAY_CANCEL_URL=http://localhost:3000/api/payments/line-pay/cancel
# Optional app return URL shown on the backend LINE Pay result page.
# Keep this aligned with mobile EXPO_PUBLIC_APP_SCHEME.
LINE_PAY_APP_RETURN_URL=drinkgroupbuy://payment/result

# Deadline settlement scheduler.
# In sandbox/dev, this can run automatically to capture/void due group-buy activities.
# If LINE_PAY_ENV=production, the scheduler is blocked unless explicitly allowed.
SETTLEMENT_SCHEDULER_ENABLED=true
SETTLEMENT_SCHEDULER_INTERVAL_MS=30000
SETTLEMENT_SCHEDULER_BATCH_SIZE=20
SETTLEMENT_SCHEDULER_ALLOW_PRODUCTION=false

# Payment reliability alert webhook (optional).
# Fires when a payment background job (LINE Pay reconciliation, settlement capture/void)
# permanently fails after exhausting retries, or when the scheduler itself crashes.
# Leave unset in sandbox/dev -- it silently no-ops. Accepts any URL that takes a JSON POST with
# a top-level "text" field (Slack, Discord, and Mattermost incoming webhooks all work directly).
ALERT_WEBHOOK_URL=

# Pickup expiration scheduler.
# Expires pickup at the earlier of pickupStartAt + 3 hours or pickupEndAt.
PICKUP_EXPIRATION_SCHEDULER_ENABLED=true
PICKUP_EXPIRATION_SCHEDULER_INTERVAL_MS=30000
PICKUP_EXPIRATION_SCHEDULER_BATCH_SIZE=20

# Push reminder before pickup closes: how many minutes before the pickup window ends a customer with a
# ready-but-unclaimed order gets "取餐時間快結束了". 0 turns the reminder off. Needs migration 010.
PICKUP_REMINDER_LEAD_MINUTES=30
